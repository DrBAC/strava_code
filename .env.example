# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Home location (used for GPS privacy anonymisation) ────────────────────────
# Right-click your home on Google Maps → "What's here?" to get coordinates.
HOME_LAT=54.0000
HOME_LON=-1.0000

# ── PostgreSQL connection ─────────────────────────────────────────────────────

# Option A: full DSN
PG_DSN=postgresql://postgres:yourpassword@localhost:5432/strava

# Option B: individual components (used if PG_DSN is not set)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=strava
PG_USER=postgres
PG_PASSWORD=yourpassword
