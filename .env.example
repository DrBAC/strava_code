# PostgreSQL connection — copy to .env and fill in your values
# (.env is gitignored; never commit real credentials)

# Option A: full DSN
PG_DSN=postgresql://postgres:yourpassword@localhost:5432/strava

# Option B: individual components (used if PG_DSN is not set)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=strava
PG_USER=postgres
PG_PASSWORD=yourpassword
